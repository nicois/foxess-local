# An example systemd unit for the aemo-spike sidecar (examples/aemo-spike).
# Install:
#   install -m 0755 aemo-spike /usr/local/bin/aemo-spike
#   install -m 0644 aemo-spike.service /etc/systemd/system/
#   install -d -m 0750 /etc/aemo-spike
#   printf 'FOXESS_TOKEN=%s\n' '<the token>' > /etc/aemo-spike/env && chmod 0600 /etc/aemo-spike/env
#   systemctl daemon-reload && systemctl enable --now aemo-spike
[Unit]
Description=aemo-spike: force-discharge on NEM price spikes (foxess-local sidecar)
After=network-online.target foxess-local.service
Wants=network-online.target

[Service]
EnvironmentFile=/etc/aemo-spike/env
# optional metrics (README "Metrics"): add to /etc/aemo-spike/env, e.g.
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://otelcol:4318
# keep the Go runtime small on an OpenStick
Environment=GOMEMLIMIT=24MiB GOGC=50
ExecStart=/usr/local/bin/aemo-spike -region VIC1 -start-above 300 -stop-below 200 -start-soc 40 -cutoff-soc 30
Restart=on-failure
RestartSec=30
DynamicUser=yes
MemoryMax=48M
CPUQuota=20%
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
